# Founders AI OS settings.
# Add these in Vercel: your project, then Settings, then Environment Variables. Redeploy after every change.
# This file only lists the names. Never put real values in it or commit a filled-in copy.
# SETUP.md explains each one.

# Required
SUPABASE_URL=                # Project URL from Supabase, like https://abcdefgh.supabase.co
SUPABASE_PUBLISHABLE_KEY=    # Publishable key from Supabase, starts with sb_publishable_ (the legacy anon key also works as SUPABASE_ANON_KEY)
FOS_ENC_KEY=                 # 32 random bytes in base64: openssl rand -base64 32. Never change it after you save keys in the app.
CRON_SECRET=                 # Long random text for the scheduled jobs: openssl rand -hex 32

# Recommended
FOS_TZ=                      # Your time zone, like America/New_York or Europe/London. Default: UTC
COACH_NAME=                  # Your full name, like Avery Cole. The AI Coach speaks as you. Default: "AI Coach"

# Optional
APP_URL=                     # Only if links in emails and sign-ins should use another address. Default: your Vercel production address
COACH_YOUTUBE_CHANNEL=       # Your YouTube channel ID (starts with UC) for the Coach library
YOUTUBE_API_KEY=             # YouTube Data API v3 key for research, outliers and channel links (GOOGLE_API_KEY also works)
GOOGLE_CLIENT_ID=            # Google OAuth app for YouTube Analytics, Calendar, Drive, Analytics, Search Console and Google Ads
GOOGLE_CLIENT_SECRET=
HL_APP_CLIENT_ID=            # HighLevel Marketplace app for one-click HighLevel sign-in
HL_APP_CLIENT_SECRET=
HL_WEBHOOK_PUBLIC_KEY=       # Only if HighLevel changes its webhook signing key. A default is built in.
FOS_ALLOW_DEMO=              # 1 lets the AI access (MCP) server accept the token "demo". Leave empty on a live install.
GOOGLE_ADS_VERSION=          # Google Ads API version. Default: v21
LINKEDIN_VERSION=            # LinkedIn API version header. Default: 202510
XERO_SCOPES=                 # Xero scopes for the Accounting connection. Default: read-only accounting scopes
CALLS_TIMEOUT=               # Milliseconds the call review waits for Claude. Default: 100000
MCP_DEBUG=                   # Any value logs MCP server errors in the Vercel logs

# AI models. Leave empty to use the defaults.
CLAUDE_MODEL=
ANTHROPIC_MODEL=
OPENAI_MODEL=
JARVIS_CLAUDE_MODEL=
JARVIS_OPENAI_MODEL=
FUNNEL_MODEL=
FUNNEL_OPENAI_MODEL=
FUNNEL_CLAUDE_BUILDER=
FUNNEL_CLAUDE_EFFORT=
FUNNEL_CODEX_BUILDER=
FUNNEL_GEMINI_BUILDER=
FUNNEL_CRAFT_MS=
FUNNEL_IMAGE_MODELS=
FUNNEL_OPENROUTER_MODELS=
ELEVEN_MODEL=
ELEVEN_BRIEF_MODEL=
ELEVEN_REALTIME_MODEL=
ELEVEN_VOICE=
PPLX_MODEL=
PPLX_RESEARCH_MODEL=
